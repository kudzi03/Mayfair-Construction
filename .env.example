# Public URL of the site (no trailing slash). Used for canonicals, sitemap, OG and JSON-LD.
# Required when NEXT_PUBLIC_ALLOW_INDEXING=true — the build fails without it.
NEXT_PUBLIC_SITE_URL=https://www.example.co.bw

# Keep false for the demo. Set to true only at launch with real content.
NEXT_PUBLIC_ALLOW_INDEXING=false

# false hides "Representative image" labels and demo notes.
NEXT_PUBLIC_DEMO_MODE=true

# URL that accepts a JSON POST of enquiry form data. Unset = demo mode (nothing is sent).
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxx

# Analytics: set ONE. Unset = no analytics script loads.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Search Console / Bing Webmaster Tools HTML-tag verification (the content="" value only).
# Not needed if Search Console is verified with a DNS record (recommended).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
