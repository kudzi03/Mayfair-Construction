# Public URL of the site (no trailing slash). Used for canonicals, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.co.bw

# Keep false for the demo. Set to true only at launch with real content.
NEXT_PUBLIC_ALLOW_INDEXING=false

# false hides "Representative image" labels and demo notes.
NEXT_PUBLIC_DEMO_MODE=true

# URL that accepts a JSON POST of enquiry form data. Unset = demo mode (nothing is sent).
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxx
